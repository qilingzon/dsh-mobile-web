{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	// lib/ is generated by build.mjs — lint the source, never the build output.
	"files": {
		"includes": ["**", "!lib/**"]
	},
	// Formatter off on purpose: the CSS/JS here is hand-formatted and reflowing
	// 1.7k lines would bury real changes under style churn.
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				// Deliberate, not accidental. The host app's CSS-module class names
				// carry build hashes (e.g. pI_x6G_sidebarCol), so the only way to
				// override them from outside is [class*="_suffix"] + !important.
				// That is this plugin's whole strategy — see the header comment in
				// src/mobile.css. Leaving the rule on buries the real findings under
				// ~230 repetitive warnings.
				"noImportantStyles": "off"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
