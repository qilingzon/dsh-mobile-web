{
  "name": "dsh-mobile-web-pro",
  "version": "2.0.4",
  "description": "DSH 移动端全功能旗舰适配插件 (Pro)：平滑历史加载、长会话性能加速、安全区与触控极致优化；<=1023px 生效，桌面零影响。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "mobile",
    "ui",
    "pro"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "NODE_PATH=/workspace/.dsh/profiles/web/node_modules npx --yes esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js",
    "build:client": "NODE_PATH=/workspace/.dsh/profiles/web/node_modules npx --yes esbuild src/client/index.ts --bundle --platform=browser --format=iife --outfile=lib/client.js --external:react"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "author": "qilingzon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qilingzon/dsh-mobile-web.git"
  },
  "bugs": {
    "url": "https://github.com/qilingzon/dsh-mobile-web/issues"
  },
  "homepage": "https://github.com/qilingzon/dsh-mobile-web#readme",
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7-rc.1"
  }
}
