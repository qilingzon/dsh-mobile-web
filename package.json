{
  "name": "dsh-mobile-web",
  "version": "1.0.0",
  "private": true,
  "description": "Full mobile-web adaptation for the DeepSeek Harness console. Every rule is gated to phone viewports, so the desktop console is never touched.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "MIT"
}
